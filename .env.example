# Convex (run `npx convex dev` once to create project and fill these)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk — admin authentication
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret — set on Convex dashboard (not .env.local)
# CLERK_WEBHOOK_SECRET=whsec_...

# Twilio — OTP via Verify API (set on Convex dashboard for production)
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Dev mode shows OTP on screen instead of Twilio SMS
NEXT_PUBLIC_USE_DEV_OTP=false
