# Convex (run `npx convex dev` once to create project and fill these)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk — admin authentication
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret — set on Convex dashboard (not .env.local)
# CLERK_WEBHOOK_SECRET=whsec_...

# Portal access — set on Convex dashboard
# ADMIN_EMAILS=admin@example.com
# VIEWER_EMAILS=viewer@example.com
# Viewers only see members from associations assigned in Admin → Viewer access
